{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybercore-mission-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "MISSION_CONTROL_DB",
      "database_name": "cybercore-mission-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_EVENTS",
        "class_name": "ProjectEventChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectEventChannel"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "staging": {
      "name": "cybercore-mission-control-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "MISSION_CONTROL_DB",
          "database_name": "cybercore-mission-control-staging",
          "database_id": "4a42bc28-31f4-4341-b765-d5d34c7c81fc",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROJECT_EVENTS",
            "class_name": "ProjectEventChannel"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ProjectEventChannel"]
        }
      ]
    },
    "production": {
      "name": "cybercore-mission-control-production",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "MISSION_CONTROL_DB",
          "database_name": "cybercore-mission-control-production",
          "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROJECT_EVENTS",
            "class_name": "ProjectEventChannel"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ProjectEventChannel"]
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
